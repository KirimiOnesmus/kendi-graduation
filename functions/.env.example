# Copy this file to .env and fill in the values.
# Change these anytime you switch between testing and live.
# After editing, run: firebase deploy --only functions

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail that sends RSVP emails (needs 2-Step Verification + App Password)
# Create the App Password at https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Sheet ID is only used inside apps-script/Code.gs
SHEET_ID=

# Must be the Apps Script web app URL ending in /exec
# NOT the spreadsheet edit link (docs.google.com/spreadsheets/...)
APPS_SCRIPT_URL=
