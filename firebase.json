{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "firestore.rules",
      "storage.rules",
      "README.md"
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
